# Copy this file to .env and paste your own key. Never commit .env.
# You can alternatively set LSM_PROVIDER and that provider's native API key.
DEEPSEEK_API_KEY=your-key-here

# Optional overrides
LSM_MODEL=deepseek-v4-pro
LSM_SMALL_MODEL=deepseek-v4-flash
LSM_HOME=.lsm
LSM_THINKING=disabled
# 交互模式默认不限轮数(0 = unlimited);eval/自动化再显式设正整数
LSM_MAX_ITERATIONS=0
LSM_MAX_TOKENS=8192
LSM_HISTORY_TURNS=12
LSM_CONTEXT_BUDGET_TOKENS=24000
LSM_CONTEXT_COMPRESSION_TOKENS=18000
LSM_CONTEXT_RECENT_TURNS=6
LSM_SUMMARY_MAX_TOKENS=1200

# Tools and runner
LSM_SHELL_TIMEOUT=60
LSM_WEB_FETCH_MAX_CHARS=8000
LSM_MAX_EMPTY_RETRIES=2
LSM_MAX_LENGTH_RECOVERIES=3
LSM_MAX_MODEL_RETRIES=2
LSM_CACHE_RETENTION=short
LSM_SUBAGENT_MAX_CONCURRENT=3

# Paid network tests are opt-in.
LSM_RUN_REAL_API=false
